# Server blocks for app.fastvibe.dev on the server's existing nginx, if it does not
# have them yet. Certificates are issued outside nginx (certbot webroot below, or
# acme.sh); certbot reloads nginx on renewal.
#
#   certbot certonly --webroot -w /var/www/acme -d app.fastvibe.dev
#
# Requires upstreams.conf in the http {} context.

server {
    listen 80;
    listen [::]:80;
    server_name app.fastvibe.dev;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.fastvibe.dev;

    ssl_certificate     /etc/letsencrypt/live/app.fastvibe.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.fastvibe.dev/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    gzip on;
    gzip_min_length 1024;
    gzip_types application/json text/css application/javascript image/svg+xml;

    include /etc/nginx/fastvibe/locations.conf;
}
