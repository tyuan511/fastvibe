  },
  "serverRequest": {
    "$defs": {
      "Question": {
        "properties": {
          "header": {
            "description": "A short heading, 12 characters or fewer.",
            "type": "string"
          },
          "id": {
            "description": "What the answer is filed under.",
            "type": "string"
          },
          "isOther": {
            "description": "Offer a free-form \"Other\" answer besides the options.",
            "type": "boolean"
          },
          "options": {
            "items": {
              "$ref": "#/$defs/QuestionOption"
            },
            "type": "array"
          },
          "question": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "header",
          "question",
          "options",
          "isOther"
        ],
        "type": "object"
      },
      "QuestionOption": {
        "properties": {
          "description": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "description"
        ],
        "type": "object"
      },
      "RequestId": {
        "anyOf": [
          {
            "format": "int64",
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "UserInputRequest": {
        "description": "`item/question/request`: the agent is stopped until the user answers.",
        "properties": {
          "callId": {
            "description": "The tool call the questions belong to.",
            "type": "string"
          },
          "questions": {
            "items": {
              "$ref": "#/$defs/Question"
            },
            "type": "array"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "turnId",
          "callId",
          "questions"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Server → client requests that wait for an answer. The client replies with a JSON-RPC\nresponse carrying the result type named on each variant, or with an error to decline.",
    "oneOf": [
      {
        "description": "Questions for the user; answered with a [`UserInputResponse`].",
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "const": "item/question/request",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/UserInputRequest"
          }
        },
        "required": [
          "method",
          "id",
          "params"
        ],
        "type": "object"
      }
    ],
    "title": "ServerRequest"
  },
  "userInputResponse": {
    "$defs": {
      "UserInputAnswer": {
        "properties": {
          "answers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "answers"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The client's answer to an `item/question/request`: each question's id to what was chosen or\ntyped. A client that will not answer replies with an error instead.",
    "properties": {
      "answers": {
        "additionalProperties": {
          "$ref": "#/$defs/UserInputAnswer"
        },
        "type": "object"
      }
    },
    "required": [
      "answers"
    ],
    "title": "UserInputResponse",
    "type": "object"
  }
}
