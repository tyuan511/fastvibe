          },
          "id": {
            "$ref": "#/$defs/RequestId"
          }
        },
        "required": [
          "id",
          "error"
        ],
        "type": "object"
      }
    ],
    "description": "One frame on the wire, before its method is looked at.",
    "title": "Message"
  },
  "serverNotification": {
    "$defs": {
      "AppSettings": {
        "description": "What every client of this server shares about how the app looks. Ids name themes from the\nclients' own catalog; one a client does not know falls back to its default.",
        "properties": {
          "darkTheme": {
            "type": "string"
          },
          "glass": {
            "description": "玻璃效果: the translucent window, where the platform has a blur to show.",
            "type": "boolean"
          },
          "lightTheme": {
            "type": "string"
          },
          "themeMode": {
            "$ref": "#/$defs/ThemeMode"
          }
        },
        "required": [
          "themeMode",
          "lightTheme",
          "darkTheme",
          "glass"
        ],
        "type": "object"
      },
      "CatalogChanged": {
        "type": "object"
      },
      "Empty": {
        "type": "object"
      },
      "Item": {
        "oneOf": [
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "userMessage",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "agentMessage",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "reasoning",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "arguments": true,
              "id": {
                "type": "string"
              },
              "isError": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "output": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "const": "toolCall",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "name",
              "arguments",
              "isError"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "const": "error",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "message"
            ],
            "type": "object"
          },
          {
            "description": "The conversation was summarized to make room; everything before this is no longer\nsent to the model (but is still shown).",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "contextCompaction",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "type": "object"
          }
        ]
      },
      "PlanStatus": {
        "enum": [
          "pending",
          "in_progress",
          "completed"
        ],
        "type": "string"
      },
      "PlanStep": {
        "properties": {
          "status": {
            "$ref": "#/$defs/PlanStatus"
          },
          "step": {
            "type": "string"
          }
        },
        "required": [
          "step",
          "status"
        ],
        "type": "object"
      },
      "RequestId": {
        "anyOf": [
          {
            "format": "int64",
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "ThemeMode": {
        "oneOf": [
          {
            "enum": [
              "light",
              "dark"
            ],
            "type": "string"
          },
          {
            "const": "system",
            "description": "Follow the operating system.",
            "type": "string"
          }
        ]
      },
      "ThinkingLevel": {
        "description": "How hard the model is asked to think. There is deliberately no \"off\".",
        "enum": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "type": "string"
      },
      "Thread": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "int64",
            "type": "integer"
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "model": {
            "default": null,
            "description": "`provider/model` this conversation uses; the default model when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "pinned": {
            "default": false,
            "description": "Kept at the top of the sidebar.",
            "type": "boolean"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "thinking": {
            "anyOf": [
              {
                "$ref": "#/$defs/ThinkingLevel"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "title": {
            "type": "string"
          },
          "unread": {
            "type": "boolean"
          },
          "updatedAt": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt",
          "archived",
          "unread"
        ],
        "type": "object"
      },
      "ThreadEvent": {
        "properties": {
          "at": {
            "default": null,
            "description": "When it happened, by the server's clock.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId"
        ],
        "type": "object"
      },
      "ThreadEvent2": {
        "properties": {
          "at": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/$defs/TurnStatus"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId",
          "status"
        ],
        "type": "object"
      },
      "ThreadEvent3": {
        "description": "`running` is true from the moment a turn is accepted until it has fully settled.",
        "properties": {
          "running": {
            "type": "boolean"
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "running"
        ],
        "type": "object"
      },
      "ThreadEvent4": {
        "properties": {
          "at": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "item": {
            "$ref": "#/$defs/Item"
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId",
          "item"
        ],
        "type": "object"
      },
      "ThreadEvent5": {
        "properties": {
          "delta": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId",
          "itemId",
          "delta"
        ],
        "type": "object"
      },
      "ThreadEvent6": {
        "description": "The model replaced its checklist. Each update is the whole list, not a change to it.",
        "properties": {
          "explanation": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan": {
            "items": {
              "$ref": "#/$defs/PlanStep"
            },
            "type": "array"
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId",
          "plan"
        ],
        "type": "object"
      },
      "ThreadEvent7": {
        "description": "How much of the model's context window the conversation takes. Summarizing starts at 90%.",
        "properties": {
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          },
          "used": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "window": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "threadId",
          "seq",
          "used",
          "window"
        ],
        "type": "object"
      },
      "ThreadEvent8": {
        "description": "A request to the client has been answered or withdrawn (by whichever client got there\nfirst, or because the turn was stopped); every other client takes its prompt down.",
        "properties": {
          "requestId": {
            "$ref": "#/$defs/RequestId"
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "requestId"
        ],
        "type": "object"
      },
      "TurnStatus": {
        "oneOf": [
          {
            "enum": [
              "completed",
              "failed"
            ],
            "type": "string"
          },
          {
            "const": "interrupted",
            "description": "Stopped by the user (`turn/interrupt`). Not a failure.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "properties": {
          "method": {
            "const": "thread/started",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/Thread"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "catalog/changed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/CatalogChanged"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "providers/changed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/Empty"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "settings/changed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/AppSettings"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "turn/started",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "turn/completed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent2"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "thread/status/changed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent3"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/started",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent4"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/completed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent4"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/agentMessage/delta",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent5"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/reasoning/delta",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent5"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/toolCall/argumentsDelta",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent5"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "turn/plan/updated",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent6"
          }
        },
        "required": [
          "method",
          "params"
        ],
