{
  "clientNotification": {
    "$defs": {
      "Empty": {
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "properties": {
          "method": {
            "const": "initialized",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/Empty"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      }
    ],
    "title": "ClientNotification"
  },
  "clientRequest": {
    "$defs": {
      "ClientCapabilities": {
        "properties": {
          "experimentalApi": {
            "default": false,
            "description": "Accept methods and notifications marked experimental.",
            "type": "boolean"
          },
          "optOutNotifications": {
            "default": [],
            "description": "Notification methods this client does not want.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ClientInfo": {
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      },
      "InitializeParams": {
        "properties": {
          "capabilities": {
            "$ref": "#/$defs/ClientCapabilities",
            "default": {
              "experimentalApi": false,
              "optOutNotifications": []
            }
          },
          "clientInfo": {
            "$ref": "#/$defs/ClientInfo"
          },
          "protocolVersion": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "clientInfo",
          "protocolVersion"
        ],
        "type": "object"
      },
      "RequestId": {
        "anyOf": [
          {
            "format": "int64",
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "ThreadIdParams": {
        "properties": {
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "threadId"
        ],
        "type": "object"
      },
      "ThreadListParams": {
        "properties": {
          "includeArchived": {
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ThreadStartParams": {
        "properties": {
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "description": "`provider/model`; the server's default when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "TurnStartParams": {
        "properties": {
          "text": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "text"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A request from a client, with its `id` and typed `params`.",
    "oneOf": [
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "const": "initialize",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/InitializeParams"
          }
        },
        "required": [
          "method",
          "id",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "const": "thread/list",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadListParams"
          }
        },
        "required": [
          "method",
          "id",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "const": "thread/start",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadStartParams"
          }
        },
        "required": [
          "method",
          "id",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "const": "thread/resume",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadIdParams"
          }
        },
        "required": [
          "method",
          "id",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "const": "thread/unsubscribe",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadIdParams"
          }
        },
        "required": [
          "method",
          "id",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "const": "turn/start",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/TurnStartParams"
          }
        },
        "required": [
          "method",
          "id",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "const": "turn/interrupt",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadIdParams"
          }
        },
        "required": [
          "method",
          "id",
          "params"
        ],
        "type": "object"
      }
    ],
    "title": "ClientRequest"
  },
  "message": {
    "$defs": {
      "ErrorObject": {
        "properties": {
          "code": {
            "format": "int64",
            "type": "integer"
          },
          "data": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "RequestId": {
        "anyOf": [
          {
            "format": "int64",
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "method": {
            "type": "string"
          },
          "params": {
            "default": null
          }
        },
        "required": [
          "id",
          "method"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "type": "string"
          },
          "params": {
            "default": null
          }
        },
        "required": [
          "method"
        ],
        "type": "object"
      },
      {
        "properties": {
          "id": {
            "$ref": "#/$defs/RequestId"
          },
          "result": true
        },
        "required": [
          "id",
          "result"
        ],
        "type": "object"
      },
      {
        "properties": {
          "error": {
            "$ref": "#/$defs/ErrorObject"
          },
          "id": {
            "$ref": "#/$defs/RequestId"
          }
        },
        "required": [
          "id",
          "error"
        ],
        "type": "object"
      }
    ],
    "description": "One frame on the wire, before its method is looked at.",
    "title": "Message"
  },
  "serverNotification": {
    "$defs": {
      "CatalogChanged": {
        "type": "object"
      },
      "Item": {
        "oneOf": [
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "userMessage",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "agentMessage",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "reasoning",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "arguments": true,
              "id": {
                "type": "string"
              },
              "isError": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "output": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "const": "toolCall",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "name",
              "arguments",
              "isError"
            ],
            "type": "object"
          },
          {
            "properties": {
              "id": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "const": "error",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id",
              "message"
            ],
            "type": "object"
          }
        ]
      },
      "Thread": {
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "int64",
            "type": "integer"
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "unread": {
            "type": "boolean"
          },
          "updatedAt": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt",
          "archived",
          "unread"
        ],
        "type": "object"
      },
      "ThreadEvent": {
        "properties": {
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId"
        ],
        "type": "object"
      },
      "ThreadEvent2": {
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/$defs/TurnStatus"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId",
          "status"
        ],
        "type": "object"
      },
      "ThreadEvent3": {
        "description": "`running` is true from the moment a turn is accepted until it has fully settled.",
        "properties": {
          "running": {
            "type": "boolean"
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "running"
        ],
        "type": "object"
      },
      "ThreadEvent4": {
        "properties": {
          "item": {
            "$ref": "#/$defs/Item"
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId",
          "item"
        ],
        "type": "object"
      },
      "ThreadEvent5": {
        "properties": {
          "delta": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "seq": {
            "description": "Monotonic per thread.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "required": [
          "threadId",
          "seq",
          "turnId",
          "itemId",
          "delta"
        ],
        "type": "object"
      },
      "TurnStatus": {
        "oneOf": [
          {
            "enum": [
              "completed",
              "failed"
            ],
            "type": "string"
          },
          {
            "const": "interrupted",
            "description": "Stopped by the user (`turn/interrupt`). Not a failure.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "properties": {
          "method": {
            "const": "thread/started",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/Thread"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "catalog/changed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/CatalogChanged"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "turn/started",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "turn/completed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent2"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "thread/status/changed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent3"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/started",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent4"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/completed",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent4"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/agentMessage/delta",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent5"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/reasoning/delta",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent5"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      },
      {
        "properties": {
          "method": {
            "const": "item/toolCall/argumentsDelta",
            "type": "string"
          },
          "params": {
            "$ref": "#/$defs/ThreadEvent5"
          }
        },
        "required": [
          "method",
          "params"
        ],
        "type": "object"
      }
    ],
    "title": "ServerNotification"
  }
}
