{
  "name": "fastvibe",
  "version": "0.8.2",
  "private": true,
  "license": "MIT",
  "description": "Desktop client for agent work, code, and cowork",
  "author": {
    "name": "FastVibe",
    "email": "dev@fastvibe.dev"
  },
  "homepage": "https://fastvibe.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tyuan511/fastvibe.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "sync:models": "node scripts/sync-models-dev.mjs",
    "sync": "node scripts/sync-models-dev.mjs",
    "predev": "node scripts/sync-models-dev.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/sync-models-dev.mjs && node scripts/check-injected-scripts.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "stage:app": "node scripts/stage-app.mjs",
    "check:scripts": "node scripts/check-injected-scripts.mjs",
    "test": "node --test 'test/**/*.test.ts'",
    "pack": "pnpm build && pnpm stage:app && electron-builder --dir",
    "dist": "pnpm build && pnpm stage:app && electron-builder --publish never",
    "dist:mac": "pnpm build && pnpm stage:app && electron-builder --mac --publish never && node scripts/notarize-dmg.mjs",
    "dist:win": "pnpm build && pnpm stage:app && electron-builder --win --publish never",
    "dist:linux": "pnpm build && pnpm stage:app && electron-builder --linux --publish never",
    "typecheck": "node scripts/check-injected-scripts.mjs && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "shadcn": "shadcn",
    "website:dev": "pnpm --filter @fastvibe/website dev",
    "website:build": "pnpm --filter @fastvibe/website build",
    "website:lint": "pnpm --filter @fastvibe/website lint",
    "website:typecheck": "pnpm --filter @fastvibe/website typecheck"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron-updater": "^6.8.9",
    "material-icon-theme": "^5.38.1",
    "node-pty": "^1.1.0",
    "sonner": "^2.0.8",
    "typebox": "1.3.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/react": "^0.3.1",
    "@shikijs/stream": "^4.4.3",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "electron": "^44.4.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "i18next": "^26.4.2",
    "katex": "^0.18.7",
    "motion": "^13.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "vite": "^7.1.6",
    "zustand": "^5.0.8"
  }
}
